DATABASE_URL=postgresql://user:password@localhost:5432/devops_gateway

# JWT signing secret (decisions.md #42). Generate locally, at least 32 characters.
# "changeme" and anything shorter than 32 characters is rejected (fail closed).
JWT_SECRET=changeme

# Password given to the seeded users by `python -m app.database.seed` (decisions.md #43).
# Generate locally; never commit a real value. Empty = seeded users cannot log in.
SEED_USER_PASSWORD=

# Google AI Studio free-tier key (decisions.md #16) - https://aistudio.google.com
GOOGLE_API_KEY=changeme

# Agent -> Gateway base URL (decisions.md #26). Empty = http://127.0.0.1:8000
GATEWAY_BASE_URL=http://127.0.0.1:8000

# Internal MCP seam (decisions.md #37, #40). Generate the token locally; never commit it.
MCP_INTERNAL_TOKEN=
# Empty = http://127.0.0.1:8000
MCP_BASE_URL=